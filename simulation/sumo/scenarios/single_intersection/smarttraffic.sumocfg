<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="network/smarttraffic.net.xml"/>
        <route-files value="routes/traffic.rou.xml"/>
        <additional-files value="detectors/detectors.add.xml,visuals/smarttraffic.poly.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="360"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
    </report>

    <output>
        <tripinfo-output value="../../output/tripinfo.xml"/>
    </output>

    <gui_only>
        <gui-settings-file value="viewsettings.xml"/>
    </gui_only>
</configuration>
