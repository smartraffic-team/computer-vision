# Arquivo de referência. A aplicação lê variáveis do ambiente do processo.
SMARTTRAFFIC_ARDUINO_PORT=/dev/ttyUSB0
SMARTTRAFFIC_ARDUINO_BAUD_RATE=9600
SMARTTRAFFIC_ARDUINO_TIMEOUT_SECONDS=1

SMARTTRAFFIC_CAMERA_INDEX=1
SMARTTRAFFIC_FRAME_WIDTH=640
SMARTTRAFFIC_FRAME_HEIGHT=480
SMARTTRAFFIC_FRAME_RATE=30
SMARTTRAFFIC_DETECTION_FRAME_SKIP=3
SMARTTRAFFIC_JPEG_QUALITY=80
SMARTTRAFFIC_MODEL_PATH=yolov8n.pt

SMARTTRAFFIC_SWITCH_TO_B_THRESHOLD=3
SMARTTRAFFIC_RETURN_TO_A_THRESHOLD=1
SMARTTRAFFIC_INACTIVITY_TIMEOUT_SECONDS=15
SMARTTRAFFIC_NORMAL_CYCLE_SECONDS=10

SMARTTRAFFIC_SECRET_KEY=troque-esta-chave
SMARTTRAFFIC_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SMARTTRAFFIC_SERVER_HOST=127.0.0.1
SMARTTRAFFIC_SERVER_PORT=5000
